{
  "name": "wedding",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "images:optimize": "node scripts/optimize-images.mjs",
    "predev": "npm run images:optimize && npm run fonts:optimize",
    "prebuild": "npm run images:optimize && npm run fonts:optimize",
    "fonts:optimize": "node scripts/optimize-fonts.mjs",
    "test:maps": "node --experimental-strip-types --test scripts/maps.test.mjs",
    "security:check": "npm audit --audit-level=low && node scripts/check-security.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "fontkit": "^2.0.4",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "typescript": "5.9.3",
    "vite": "^8.3.4"
  }
}
